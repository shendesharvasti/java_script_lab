<!DOCTYPE html>
<html>
<head>
    <title>Gym Admission Form</title>
    <style>
        body {
            font-family: Arial;
            margin: 30px;
        }

        form {
            width: 350px;
        }

        input, select {
            width: 100%;
            padding: 8px;
            margin: 6px 0 12px;
        }

        .error {
            color: red;
            font-size: 13px;
        }

        button {
            padding: 10px 20px;
        }
    </style>
</head>

<body>

<h2>Gym Admission Form</h2>

<form id="gymForm">

    <label>Name:</label>
    <input type="text" id="name">
    <span id="nameError" class="error"></span>

    <label>Email:</label>
    <input type="text" id="email">
    <span id="emailError" class="error"></span>

    <label>Age:</label>
    <input type="number" id="age">
    <span id="ageError" class="error"></span>

    <label>Phone:</label>
    <input type="text" id="phone">
    <span id="phoneError" class="error"></span>

    <label>Membership:</label>
    <select id="membership">
        <option value="">Select Membership</option>
        <option value="Monthly">Monthly</option>
        <option value="Quarterly">Quarterly</option>
        <option value="Yearly">Yearly</option>
    </select>
    <span id="membershipError" class="error"></span>

    <button type="submit">Submit</button>

</form>

<script>

    // Access form fields
    const name = document.getElementById("name");
    const email = document.getElementById("email");
    const age = document.getElementById("age");
    const phone = document.getElementById("phone");
    const membership = document.getElementById("membership");

    // Live validation using input events
    name.addEventListener("input", function() {
        if (name.value.trim() === "") {
            document.getElementById("nameError").textContent =
                "Name is required";
        } else {
            document.getElementById("nameError").textContent = "";
        }
    });

    email.addEventListener("input", function() {
        let pattern = /^[^ ]+@[^ ]+\.[a-z]{2,3}$/;

        if (!pattern.test(email.value)) {
            document.getElementById("emailError").textContent =
                "Enter a valid email";
        } else {
            document.getElementById("emailError").textContent = "";
        }
    });

    age.addEventListener("input", function() {
        if (age.value < 16 || age.value > 80) {
            document.getElementById("ageError").textContent =
                "Age must be between 16 and 80";
        } else {
            document.getElementById("ageError").textContent = "";
        }
    });

    phone.addEventListener("input", function() {
        let pattern = /^[0-9]{10}$/;

        if (!pattern.test(phone.value)) {
            document.getElementById("phoneError").textContent =
                "Enter a valid 10-digit phone number";
        } else {
            document.getElementById("phoneError").textContent = "";
        }
    });

    membership.addEventListener("change", function() {
        if (membership.value === "") {
            document.getElementById("membershipError").textContent =
                "Please select a membership";
        } else {
            document.getElementById("membershipError").textContent = "";
        }
    });

    // Form submit event
    document.getElementById("gymForm").addEventListener("submit", function(event) {

        event.preventDefault();

        if (
            name.value.trim() !== "" &&
            email.value !== "" &&
            age.value >= 16 &&
            age.value <= 80 &&
            /^[0-9]{10}$/.test(phone.value) &&
            membership.value !== ""
        ) {
            alert("Gym admission form submitted successfully!");
        } else {
            alert("Please correct the errors before submitting.");
        }
    });

</script>

</body>
</html>
